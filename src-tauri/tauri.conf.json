{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "91",
  "version": "2.2.14",
  "identifier": "local.gpt.cost.calculator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "91",
        "width": 1360,
        "height": 880,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxRjNGNkFGQjM5N0FDQkMKUldTOHJKZXpyL2J6Y2FDbUl5MFA4SHR1eE45N3RORUg4TzZJb0dkMVJveSs3Q0F5bzFoNDVkOE4K",
      "endpoints": [
        "https://github.com/aaa150010/gpt-pool-analyzer/releases/latest/download/latest.json"
      ]
    }
  }
}
